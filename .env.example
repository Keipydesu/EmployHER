# The local harness accepts synthetic fixtures only. Never enable in deployment.
PROFILE_DEMO_MODE=false
# Optional live extraction/embedding of synthetic fixtures in the local harness.
PROFILE_DEMO_GEMINI=false
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_EMBEDDING_MODEL=
# Schema contract: 768. Person B must use the identical model/configuration.
GEMINI_EMBEDDING_DIMENSIONS=768
# Supplied to the PostgreSQL adapter by Person C; not auto-connected by the demo.
DATABASE_URL=
# Canonical application origin for production CSRF checks (set by C).
APP_BASE_URL=
# Auth0 application credentials (set by C). Configuring any of these enables
# real sign-in; see src/server/auth0.ts.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
# Stopgap pilot gating for real résumé intake until a real consent flow
# exists: comma-separated Auth0 `sub` values allowed to submit real text.
# See authorizeIntake in src/server/authorize.ts.
PILOT_ALLOWED_AUTH0_SUBS=
