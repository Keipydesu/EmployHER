# Copy to .env only if it does not already exist; put your key in that ignored
# file, never in this template. Restart npm run dev after changing configuration.
# To use Gemini at /profile: set BOTH flags below to true and fill all three
# GEMINI_API_KEY / GEMINI_MODEL / GEMINI_EMBEDDING_MODEL values.
# The local harness accepts synthetic fixtures only. Never enable in deployment.
PROFILE_DEMO_MODE=false
# Optional live extraction/embedding of synthetic fixtures in the local harness.
PROFILE_DEMO_GEMINI=false
GEMINI_API_KEY=
# Bare model ID supporting structured generateContent (no models/ prefix).
GEMINI_MODEL=
# Bare model ID supporting embedContent, SEMANTIC_SIMILARITY and 768 dimensions.
# Keep the same embedding model/configuration for profile and job vectors.
GEMINI_EMBEDDING_MODEL=
# Documentation only — the app is not parameterized by this variable; the
# schema hardcodes 768 dimensions (src/profile/contracts.ts LIMITS.dimensions)
# and the adapter requests that exact outputDimensionality from Gemini.
# Person B must use the identical 768-dimension configuration.
GEMINI_EMBEDDING_DIMENSIONS=768
# Supplied to the PostgreSQL adapter by Person C; not auto-connected by the demo.
DATABASE_URL=
# Canonical application origin for production CSRF checks and Auth0 callbacks.
APP_BASE_URL=
# Auth0 is optional: leave all four blank (plus APP_BASE_URL) to run without
# sign-in. Setting any one of these five is treated as a misconfiguration
# unless all five are set — the SDK errors at startup naming what's missing.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
