# Copy to .env only if it does not already exist; put your key in that ignored
# file, never in this template. Restart npm run dev after changing configuration.
# To use Gemini at /demo/profile: set BOTH flags below to true and fill all three
# GEMINI_API_KEY / GEMINI_MODEL / GEMINI_EMBEDDING_MODEL values.
# The local harness accepts synthetic fixtures only. Never enable in deployment.
PROFILE_DEMO_MODE=false
# Optional live extraction/embedding of synthetic fixtures in the local harness.
PROFILE_DEMO_GEMINI=false
GEMINI_API_KEY=
# Bare model ID supporting structured generateContent (no models/ prefix).
GEMINI_MODEL=
# Bare model ID supporting embedContent, SEMANTIC_SIMILARITY and 768 dimensions.
# Keep the same embedding model/configuration for profile and job vectors.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Documentation only — the app is not parameterized by this variable; the
# schema hardcodes 768 dimensions (src/profile/contracts.ts LIMITS.dimensions)
# and the adapter requests that exact outputDimensionality from Gemini.
# Person B must use the identical 768-dimension configuration.
GEMINI_EMBEDDING_DIMENSIONS=768
# Tiger Data: paste the service's PostgreSQL connection URI into local .env.
# Format: postgresql://USERNAME:URL_ENCODED_PASSWORD@HOST:PORT/DATABASE
# Use the actual host, port and database from Tiger Data's connection panel.
# URL-encode password characters such as @, #, / and : in a URI.
# Remote TLS certificate verification is always enabled by the app; sslmode
# URL parameters cannot disable it. The sample demo does not need a database.
DATABASE_URL=
# Canonical application origin for production CSRF checks and Auth0 callbacks.
APP_BASE_URL=
# Auth0 is optional: leave all four blank to run without sign-in. APP_BASE_URL
# alone (e.g. for CI/Playwright's canonical origin) does not trigger Auth0 --
# only these four do. Setting any one of them requires all four plus
# APP_BASE_URL, or the SDK errors at startup naming what's missing.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=

# After filling DATABASE_URL, run npm run db:migrate to apply the schema.
# Opt-in authenticated runtime; enable only after migrations succeed and all
# Auth0/application-origin and Gemini settings above have been configured.
# Private intake defaults to supplied fixtures; local personal mode is below.
PLATFORM_ENABLED=false
# Local MVP opt-in only; requires a loopback APP_BASE_URL and authenticated consent.
# External Gemini data handling still applies. Default off for new checkouts.
PERSONAL_RESUME_ENABLED=false
# Only for a disposable local PostgreSQL test server, never remote Tiger Data.
DATABASE_ALLOW_INSECURE_LOCAL=false
# Optional PEM certificate authority if your service requires a custom CA.
# Leave blank when the service certificate validates with the default trust store.
DATABASE_CA_CERT=

# Backboard API credential for opted-in career context storage (server only).
# Keep blank until provisioned. Never paste real keys into tracked files.
BACKBOARD_API_KEY=
