{
  "name": "employher",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck",
    "smoke": "node scripts/smoke.mjs",
    "smoke:opportunities": "node scripts/smoke-opportunities.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "test:demo": "playwright test --config playwright.demo.config.ts",
    "smoke:profile": "node scripts/smoke-profile.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs"
  },
  "dependencies": {
    "@auth0/nextjs-auth0": "4.29.0",
    "drizzle-orm": "0.45.2",
    "next": "16.3.4",
    "pdfjs-dist": "6.3.289",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "prettier": "3.9.6",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
